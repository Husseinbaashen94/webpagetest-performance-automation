# Copy this file to .env and fill in only what you want to change.
# Every value is optional: leave it empty to use the default shown in the comment.
# .env is git-ignored, so values you put there are never committed.

# Your WebPageTest API key, required only for the live performance tests.
# Get one at https://www.webpagetest.org/signup
WPT_API_KEY=

# Test runs per page; the median is used (default: 3)
WPT_RUNS=

# WebPageTest server (default: https://www.webpagetest.org)
WPT_BASE_URL=
